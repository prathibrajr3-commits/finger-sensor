<UserControl x:Class="AirGestureAI.Views.PluginBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A2E"
             Foreground="White"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Plugin Item Style -->
        <Style x:Key="PluginItem" TargetType="ListBoxItem">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#FFCCCCEE"/>
            <Setter Property="Padding"      Value="12,10"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF2A2A5A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF22224A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Accent Card Border -->
        <Style x:Key="MetaCard" TargetType="Border">
            <Setter Property="Background"      Value="#FF141428"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="BorderBrush"     Value="#FF2A2A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>   <!-- Plugin List -->
            <ColumnDefinition Width="*"/>     <!-- Details & Security -->
        </Grid.ColumnDefinitions>

        <!-- ── Left List ────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="#FF141428" BorderBrush="#FF2A2A4A" BorderThickness="0 0 1 0">
            <DockPanel>
                <!-- Toolbar -->
                <Border DockPanel.Dock="Top" Padding="12,10" Background="#FF0F0F20">
                    <Grid>
                        <TextBlock Text="Extensions Browser" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="↻ Refresh" Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Right" Padding="8,4" Background="#FF2A2A4A" Foreground="#FFCCCCEE"
                                BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
                <!-- Plugins list -->
                <ListBox ItemsSource="{Binding Plugins}"
                         SelectedItem="{Binding SelectedPlugin}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource PluginItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                    <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" FontSize="11" Foreground="#FF8888AA" Margin="0 2 0 0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="8 0 0 0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Right details ──────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Name & Author -->
                <RowDefinition Height="Auto"/>  <!-- Description -->
                <RowDefinition Height="*"/>     <!-- Security & Permissions -->
                <RowDefinition Height="Auto"/>  <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- Name / Author -->
            <StackPanel Grid.Row="0" Margin="0 0 0 16">
                <TextBlock Text="{Binding SelectedPlugin.Name, FallbackValue='Select a plugin'}"
                           FontSize="24" FontWeight="Bold" Foreground="#FF7B61FF"/>
                <TextBlock Text="{Binding SelectedPlugin.Author, StringFormat='Developed by {0}', FallbackValue=''}"
                           FontSize="12" Foreground="#FF9999BB" Margin="0 4 0 0"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="1" Text="{Binding SelectedPlugin.Description, FallbackValue=''}"
                       FontSize="13" Foreground="#FFCCCCEE" TextWrapping="Wrap" LineHeight="20" Margin="0 0 0 24"/>

            <!-- Security & Details cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="🛡️ Security &amp; Sandbox Status" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" Margin="0 0 0 12"/>

                    <!-- Sandbox status card -->
                    <Border Style="{StaticResource MetaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sandboxing" FontWeight="SemiBold" Foreground="#FF9999BB"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.SandboxingStatus, FallbackValue='—'}" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Permissions status card -->
                    <Border Style="{StaticResource MetaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Permissions" FontWeight="SemiBold" Foreground="#FF9999BB"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.PermissionsDisplay, FallbackValue='—'}" Foreground="White" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Code Signature card -->
                    <Border Style="{StaticResource MetaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Signature Code" FontWeight="SemiBold" Foreground="#FF9999BB"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.SignatureStatus, FallbackValue='—'}" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- System compatibility card -->
                    <Border Style="{StaticResource MetaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Min Core Version" FontWeight="SemiBold" Foreground="#FF9999BB"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.MinCoreVersion, FallbackValue='—'}" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Targets applications card -->
                    <Border Style="{StaticResource MetaCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target Apps" FontWeight="SemiBold" Foreground="#FF9999BB"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.SupportedAppsDisplay, FallbackValue='—'}" Foreground="White" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="#FF0F0F20" Padding="12,6" Margin="-24,24,-24,-24">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FF666688" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
