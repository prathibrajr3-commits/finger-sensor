                                <TextBox x:Name="AgentGoalInput" Text="open the file, summarize it, and notify user" Background="#2A2A2A" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,0,12"/>
                                <Button Content="Submit Goal" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="SubmitAgentGoal_Click"/>
                                <TextBlock x:Name="AgentTaskQueueText" Text="Queue Depth: 0" Foreground="#888888" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Tab 10: Memory & Workflows (Milestone 6) ═════════════════ -->
            <TabItem Header="🧠  Autonomous">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Workflow Recorder" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <TextBlock x:Name="WorkflowStatusText" Text="Recorder State: Idle" Foreground="#888888" FontSize="12" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start Recording" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Padding="12,6" Click="StartRecordingWorkflow_Click"/>
                                    <Button Content="Stop Recording" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" Click="StopRecordingWorkflow_Click"/>
                                    <Button Content="Replay Workflow" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="ReplayWorkflow_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Long-Term Memories" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <TextBlock x:Name="MemoryCountText" Text="Stored Memories: 0" Foreground="#888888" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Tab 11: Production & Profiler (Milestone 7) ══════════════ -->
            <TabItem Header="🚀  Production">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Operations Dashboard" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <TextBlock x:Name="LiveProfilingText" Text="Live Performance: Latency: 0.00ms | Gen2 collections: 0" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run Accessibility (A11Y) Audit" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Padding="12,6" Click="RunA11yAudit_Click"/>
                                    <Button Content="Generate Production Release" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="GenerateReleasePackage_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Tab 12: Gesture Manager (v4.1) ═══════════════════════════ -->
            <TabItem Header="🖐️  Gestures">
                <ContentControl x:Name="GestureManagerContent" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ═══ Tab 13: Workflow Studio (v4.1) ═══════════════════════════ -->
            <TabItem Header="⚡  Workflows">
                <ContentControl x:Name="WorkflowEditorContent" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ═══ Tab 14: Health Monitor (v4.1) ════════════════════════════ -->
            <TabItem Header="📊  Health">
                <ContentControl x:Name="PerformanceDashboardContent" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ═══ Tab 15: Plugins (v4.1) ═══════════════════════════════════ -->
            <TabItem Header="🔌  Plugins">
                <ContentControl x:Name="PluginBrowserContent" Margin="0,12,0,0"/>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Version 4.1 RTM • Built for Windows Desktop" FontSize="10" Foreground="#666666"/>
            <TextBlock Text="Press Escape to exit tracking overlay" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
