<Window x:Class="AirGestureAI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AirGesture AI - Control Center" Height="760" Width="1100"
        Background="#121212" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, Roboto">
    
    <Window.Resources>
        <!-- Modern ScrollViewer styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Hover State Button Template -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B5ED7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Title Bar Info -->
            <RowDefinition Height="Auto"/>
            <!-- Recovery / Safe-Mode Banner (hidden unless recovery event occurred) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="AIRGESTURE AI" FontSize="24" FontWeight="Bold" Foreground="#0D6EFD"/>
                <TextBlock Text="Virtual Cursor &amp; Gesture Control Center" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusLed" Width="10" Height="10" Fill="#FF4444" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Stopped" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Phase 6: Recovery Status Banner ─────────────────────────────
             Visibility is toggled by MainWindow_Loaded when RecoveryStatus
             indicates an abnormal shutdown or Safe Mode activation.
             Collapsed by default so it adds zero layout cost on clean starts. -->
        <Border x:Name="RecoveryBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                CornerRadius="8"
                Margin="0,0,0,10"
                Padding="14,10">
            <Border.Background>
                <!-- background set from code-behind based on severity -->
                <SolidColorBrush x:Name="RecoveryBannerBrush" Color="#7C3B00"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock x:Name="RecoveryBannerIcon"
                           Grid.Column="0"
                           Text="⚠"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="#FFC107"/>

                <!-- Message -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="RecoveryBannerTitle"
                               Text="Session Recovered"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                    <TextBlock x:Name="RecoveryBannerMessage"
                               Text=""
                               FontSize="11"
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Dismiss button -->
                <Button x:Name="RecoveryBannerDismiss"
                        Grid.Column="2"
                        Content="✕"
                        Width="24" Height="24"
                        Background="Transparent"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontSize="12"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Click="RecoveryBannerDismiss_Click"
                        ToolTip="Dismiss this notification"/>
            </Grid>
        </Border>

        <!-- Main Body – Tab Control -->
        <TabControl Grid.Row="2"
                    Background="#121212"
                    BorderThickness="0"
                    Padding="0">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"        Value="#1A1A1A"/>
                    <Setter Property="Foreground"        Value="#888888"/>
                    <Setter Property="BorderThickness"   Value="0"/>
                    <Setter Property="Padding"           Value="18,10"/>
                    <Setter Property="FontSize"          Value="12"/>
                    <Setter Property="FontWeight"        Value="SemiBold"/>
                    <Setter Property="Cursor"            Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderThickness="0,0,0,3"
                                        BorderBrush="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush"   Value="#0D6EFD"/>
                                        <Setter TargetName="Bd" Property="Background"    Value="#1E1E1E"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ═══ Tab 1: Dashboard (original layout) ════════════════════════ -->
            <TabItem Header="⬤  Dashboard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Control & Stats Panel -->
                    <Grid Grid.Column="0" Margin="0,12,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Camera Selection Card -->
                        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Webcam Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0D6EFD"/>
                                <TextBlock Text="Select Device" FontSize="11" Foreground="#888888" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CameraComboBox" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="8,6" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartBtn" Content="Start" Style="{StaticResource ModernButton}" Margin="0,0,5,0" Click="StartBtn_Click"/>
                                    <Button x:Name="StopBtn"  Content="Stop"  Style="{StaticResource SecondaryButton}" Grid.Column="1" Margin="5,0,0,0" IsEnabled="False" Click="StopBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics & Health Card -->
                        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Component Diagnostics" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0D6EFD"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Overall Pipeline:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="PipelineHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PipelineHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Camera Sensor:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="CameraHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CameraHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Python Hand Tracker:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="PythonHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PythonHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Cursor Engine Overlay:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="CursorHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CursorHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Hover Dwell Engine:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="HoverHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HoverHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Gesture Recognition:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="GestureHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GestureHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Windows Input Simulator:" Foreground="#CCCCCC" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="InputHealthLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="InputHealthText" Text="Stopped" Foreground="#888888" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Performance Metrics Card -->
                        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Performance Profiling" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0D6EFD"/>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="FPS (Camera/Process/Cursor):" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="FpsDetailsText" Text="0.0 / 0.0 / 0.0" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="End-to-End Latency:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="E2eLatencyText" Text="0.0 ms" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="AI Inference Latency:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="InferenceLatencyText" Text="0.0 ms" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="CPU Usage (App):" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="CpuUsageText" Text="0.0 %" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="RAM Memory Usage:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="RamUsageText" Text="0.0 MB" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Cursor / Active Gesture:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="StateDetailsText" Text="Hand Lost / None" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Hand Presence:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="HandPresenceText" Text="Not Detected" Foreground="#FF4444" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- App Context & Plugins Card -->
                        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="App Context &amp; Plugins" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0D6EFD"/>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Foreground App:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="ForegroundAppText" Text="Unknown (PID 0)" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Window Title:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="ForegroundWindowTitleText" Text="None" Foreground="#CCCCCC" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="YouTube Page:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="YouTubePageTypeText" Text="None" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Active Plugin Adapters:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock x:Name="ActivePluginsText" Text="1 Loaded" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Logs Console -->
                        <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="10" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="System Output" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0D6EFD"/>
                                <ListBox x:Name="LogsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" FontSize="9" FontFamily="Consolas">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"    Value="0,1"/>
                                            <Setter Property="Focusable"  Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Video Preview -->
                    <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Live Camera Stream" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0D6EFD"/>
                            <Border Grid.Row="1" Background="#0C0C0C" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Camera Stream Offline" FontSize="18" FontWeight="SemiBold" Foreground="#444444" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Select a webcam and click Start to begin virtual cursor tracking." FontSize="11" Foreground="#333333" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 2: Developer Center (Phase 24) ══════════════════════════ -->
            <TabItem Header="🛠  Developer Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,0">

                        <!-- SDK Info Card -->
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SDK Information" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="SDK Version:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="SdkVersionText" Text="4.1.0" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Compatibility Mode:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="CompatModeText" Text="Enabled" Foreground="#22C55E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Installed Extensions:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock x:Name="InstalledExtensionsText" Text="0" Foreground="#0D6EFD" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Extension Installer Card -->
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Extension Marketplace" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <TextBlock Text="Install an extension (.airgesture-extension):" Foreground="#888888" FontSize="11" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExtensionPathBox" Background="#2D2D2D" Foreground="#CCCCCC" BorderThickness="0"
                                             Padding="8,6" FontSize="11" IsReadOnly="True"
                                             Text="Select a .airgesture-extension file…"/>
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0" Click="BrowseExtension_Click"/>
                                </Grid>
                                <Button x:Name="InstallExtensionBtn" Content="Install Extension"
                                        Style="{StaticResource ModernButton}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Padding="20,8"
                                        Click="InstallExtension_Click"/>
                                <TextBlock x:Name="ExtensionStatusText" Text="" Foreground="#22C55E"
                                           FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- API Documentation Card -->
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="API Documentation" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <TextBlock Text="Generate API docs for the AirGesture AI SDK." Foreground="#888888" FontSize="11" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="GenHtmlDocsBtn"  Content="Generate HTML Docs" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Padding="16,8" Click="GenerateHtmlDocs_Click"/>
                                    <Button x:Name="GenMdDocsBtn"    Content="Generate Markdown" Style="{StaticResource SecondaryButton}" Padding="16,8" Click="GenerateMdDocs_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DocsStatusText" Text="" Foreground="#22C55E" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Sample Project Generator Card -->
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sample Project Generator" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <TextBlock Text="Template Type:" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
                                <ComboBox x:Name="TemplateTypeCombo" Background="#2D2D2D" Foreground="White" BorderThickness="0"
                                          Padding="8,6" Margin="0,0,0,10" FontSize="11">
                                    <ComboBoxItem Content="GesturePlugin"    IsSelected="True"/>
                                    <ComboBoxItem Content="VoicePlugin"/>
                                    <ComboBoxItem Content="AIPlugin"/>
                                    <ComboBoxItem Content="AutomationPlugin"/>
                                    <ComboBoxItem Content="VisionPlugin"/>
                                    <ComboBoxItem Content="AgentPlugin"/>
                                    <ComboBoxItem Content="EnterprisePlugin"/>
                                </ComboBox>
                                <TextBlock Text="Plugin Name:" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox x:Name="PluginNameBox" Background="#2D2D2D" Foreground="#CCCCCC"
                                         BorderThickness="0" Padding="8,6" FontSize="11"
                                         Text="MyCustomPlugin" Margin="0,0,0,10"/>
                                <Button x:Name="GenerateSampleBtn" Content="Create Sample Project"
                                        Style="{StaticResource ModernButton}" HorizontalAlignment="Left"
                                        Padding="20,8" Click="GenerateSampleProject_Click"/>
                                <TextBlock x:Name="SampleStatusText" Text="" Foreground="#22C55E"
                                           FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Compatibility & Deprecation Warnings Card -->
                        <Border Background="#1E1E1E" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Deprecation Warnings" FontSize="14" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>
                                <ListBox x:Name="DeprecationWarningsList" Background="Transparent" BorderThickness="0"
                                         Foreground="#FFAB40" FontSize="11" FontFamily="Consolas" MaxHeight="120">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"    Value="0,2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Focusable"  Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="NoWarningsText" Text="✓ No deprecation warnings." Foreground="#22C55E"
                                           FontSize="11" Margin="0,4,0,0"/>
