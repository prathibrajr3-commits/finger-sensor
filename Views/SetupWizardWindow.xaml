<Window x:Class="AirGestureAI.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AirGestureAI.Views"
        Title="AirGesture AI — Setup Wizard"
        Width="720" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1A1A2E"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Step Indicator Style -->
        <Style x:Key="StepDot" TargetType="Ellipse">
            <Setter Property="Width"  Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill"   Value="#FF444466"/>
            <Setter Property="Margin" Value="4 0"/>
        </Style>
        <Style x:Key="ActiveStepDot" BasedOn="{StaticResource StepDot}" TargetType="Ellipse">
            <Setter Property="Fill" Value="#FF7B61FF"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#FF7B61FF"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Padding"      Value="24 8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF9A82FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3A3A5A"/>
                                <Setter Property="Foreground" Value="#FF888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryBtn" BasedOn="{StaticResource PrimaryBtn}" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A4A"/>
        </Style>

        <!-- Check Item DataTemplate -->
        <DataTemplate x:Key="CheckItemTemplate">
            <Grid Margin="0 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding CheckName}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="#FFCCCCEE"/>
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#FF9999BB" FontSize="12"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#FF0F0F20" Padding="32 20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding CurrentStep.Title}"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding CurrentStep.Subtitle}"
                               FontSize="13" Foreground="#FF9999BB" Margin="0 4 0 0"/>
                </StackPanel>
                <!-- Step dots -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" Margin="4 0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF444466"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Fill" Value="#FF7B61FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ── Content area ────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Padding="40 30">
            <Grid>
                <!-- Step 0: Welcome -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={x:Static local:IndexToVisibilityConverter.Step0}}">
                    <TextBlock FontSize="16" Foreground="#FFCCCCEE" TextWrapping="Wrap" LineHeight="26">
                        Welcome to <Run FontWeight="Bold" Foreground="#FF7B61FF">AirGesture AI</Run>!
                        This wizard will check your environment, calibrate your camera, and teach
                        you the standard gesture vocabulary before you start.
                    </TextBlock>
                    <TextBlock Margin="0 20 0 0" FontSize="14" Foreground="#FF9999BB" TextWrapping="Wrap">
                        The setup takes less than two minutes. Click <Run FontWeight="Bold">Next</Run> to begin.
                    </TextBlock>
                </StackPanel>

                <!-- Step 1: Environment checks -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={x:Static local:IndexToVisibilityConverter.Step1}}">
                    <TextBlock Text="Environment Pre-Checks" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFCCCCEE" Margin="0 0 0 12"/>
                    <ItemsControl ItemsSource="{Binding CheckItems}"
                                  ItemTemplate="{StaticResource CheckItemTemplate}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF9999BB"
                               FontSize="12" Margin="0 16 0 0" TextWrapping="Wrap"/>
                    <Button Content="Run Checks" Command="{Binding RunChecksCommand}"
                            Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"
                            Margin="0 16 0 0"/>
                </StackPanel>

                <!-- Step 2: Calibration -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={x:Static local:IndexToVisibilityConverter.Step2}}">
                    <TextBlock FontSize="14" Foreground="#FFCCCCEE" TextWrapping="Wrap" LineHeight="22">
                        Position your webcam so your hand is visible in the centre of the frame.
                        Keep approximately 50–70 cm distance. Avoid bright backlighting.
                    </TextBlock>
                    <Border Margin="0 20 0 0" Background="#FF0F0F20" CornerRadius="8"
                            Padding="24" BorderBrush="#FF7B61FF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💡 Calibration Tips" FontWeight="Bold" Foreground="#FF7B61FF" Margin="0 0 0 8"/>
                            <TextBlock Text="• Ensure even lighting from the front." Foreground="#FF9999BB"/>
                            <TextBlock Text="• Keep background simple (solid wall preferred)." Foreground="#FF9999BB" Margin="0 4 0 0"/>
                            <TextBlock Text="• Avoid wearing gloves or bracelets on your tracking hand." Foreground="#FF9999BB" Margin="0 4 0 0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 3: Gesture Tutorial -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={x:Static local:IndexToVisibilityConverter.Step3}}">
                    <TextBlock Text="Standard Gestures" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFCCCCEE" Margin="0 0 0 16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Scroll Up -->
                        <Border Grid.Column="0" Background="#FF0F0F20" CornerRadius="8" Padding="16" Margin="0 0 8 0">
                            <StackPanel>
                                <TextBlock Text="☝️" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Scroll Up" FontWeight="Bold" Foreground="#FF7B61FF"
                                           HorizontalAlignment="Center" Margin="0 8 0 0"/>
                                <TextBlock Text="Swipe hand upward" Foreground="#FF9999BB" FontSize="11"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                        <!-- Scroll Down -->
                        <Border Grid.Column="1" Background="#FF0F0F20" CornerRadius="8" Padding="16" Margin="4 0">
                            <StackPanel>
                                <TextBlock Text="👇" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Scroll Down" FontWeight="Bold" Foreground="#FF7B61FF"
                                           HorizontalAlignment="Center" Margin="0 8 0 0"/>
                                <TextBlock Text="Swipe hand downward" Foreground="#FF9999BB" FontSize="11"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                        <!-- Open Palm -->
                        <Border Grid.Column="2" Background="#FF0F0F20" CornerRadius="8" Padding="16" Margin="8 0 0 0">
                            <StackPanel>
                                <TextBlock Text="🖐️" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open Palm" FontWeight="Bold" Foreground="#FF7B61FF"
                                           HorizontalAlignment="Center" Margin="0 8 0 0"/>
                                <TextBlock Text="Spread fingers fully" Foreground="#FF9999BB" FontSize="11"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Step 4: Complete -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={x:Static local:IndexToVisibilityConverter.Step4}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="You're all set!" FontSize="24" FontWeight="Bold"
                               Foreground="#FF7B61FF" HorizontalAlignment="Center" Margin="0 16 0 0"/>
                    <TextBlock Foreground="#FF9999BB" FontSize="14" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0 8 0 0">
                        AirGesture AI is configured and ready.&#x0a;Click Finish to start tracking.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#FF0F0F20" Padding="32 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back" Command="{Binding BackCommand}"
                        Style="{StaticResource SecondaryBtn}"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="#FF666688" FontSize="11" Margin="16 0" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="Next →" Command="{Binding NextCommand}"
                        Style="{StaticResource PrimaryBtn}" Margin="0 0 8 0"
                        Visibility="{Binding IsLastStep, Converter={x:Static local:BoolToInverseVisibilityConverter.Instance}}"/>
                <Button Grid.Column="3" Content="Finish ✓" Command="{Binding FinishCommand}"
                        Style="{StaticResource PrimaryBtn}"
                        Visibility="{Binding IsLastStep, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
