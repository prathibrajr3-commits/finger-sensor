<UserControl x:Class="AirGestureAI.Views.WorkflowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A2E"
             Foreground="White"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Toolbar button -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FF2A2A4A"/>
            <Setter Property="Foreground"      Value="#FFCCCCEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10 6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0 0 6 0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A3A6A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Node card template -->
        <DataTemplate x:Key="NodeCardTemplate">
            <Border Width="140" Height="80" CornerRadius="8"
                    Background="#FF1E1E38" BorderThickness="2"
                    Margin="4">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{Binding NodeColor}"/>
                </Border.BorderBrush>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#FF2A2A5A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NodeIcon}" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="White"
                               FontSize="12" HorizontalAlignment="Center" Margin="0 4 0 0"/>
                    <TextBlock Text="{Binding Parameter}" Foreground="#FF9999BB" FontSize="10"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Canvas + Properties -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#FF0F0F20" Padding="16 10">
            <StackPanel Orientation="Horizontal">
                <!-- Workflow name -->
                <TextBlock Text="Workflow:" Foreground="#FF9999BB" VerticalAlignment="Center" Margin="0 0 8 0"/>
                <TextBox Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF1A1A2E" Foreground="White"
                         BorderBrush="#FF3A3A6A" BorderThickness="1"
                         Padding="6 4" Width="180" VerticalAlignment="Center" Margin="0 0 16 0"/>

                <Separator Background="#FF2A2A4A" Width="1" Margin="0 0 16 0"/>

                <!-- Add nodes -->
                <Button Content="⚡ Action"    Command="{Binding AddActionCommand}"    Style="{StaticResource TbBtn}"/>
                <Button Content="⏱️ Delay"     Command="{Binding AddDelayCommand}"     Style="{StaticResource TbBtn}"/>
                <Button Content="❓ Condition" Command="{Binding AddConditionCommand}" Style="{StaticResource TbBtn}"/>
                <Button Content="🔁 Loop"      Command="{Binding AddLoopCommand}"      Style="{StaticResource TbBtn}"/>

                <Separator Background="#FF2A2A4A" Width="1" Margin="0 0 16 0"/>

                <!-- Operations -->
                <Button Content="↑ Up"     Command="{Binding MoveUpCommand}"   Style="{StaticResource TbBtn}"/>
                <Button Content="↓ Down"   Command="{Binding MoveDownCommand}" Style="{StaticResource TbBtn}"/>
                <Button Content="🗑 Delete" Command="{Binding DeleteNodeCommand}" Style="{StaticResource TbBtn}"/>
                <Button Content="✕ Clear"  Command="{Binding ClearCommand}"    Style="{StaticResource TbBtn}"/>

                <Separator Background="#FF2A2A4A" Width="1" Margin="0 0 16 0"/>

                <!-- File operations -->
                <Button Content="💾 Save" Command="{Binding SaveCommand}" Style="{StaticResource TbBtn}"/>
                <Button Content="📂 Open" Command="{Binding LoadCommand}" Style="{StaticResource TbBtn}"/>
            </StackPanel>
        </Border>

        <!-- ── Canvas + Properties ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Canvas -->
                <ColumnDefinition Width="240"/>  <!-- Properties panel -->
            </Grid.ColumnDefinitions>

            <!-- Visual canvas (scrollable node list) -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#FF141428">
                <ItemsControl ItemsSource="{Binding Nodes}" Margin="16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <ContentPresenter ContentTemplate="{StaticResource NodeCardTemplate}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Properties panel -->
            <Border Grid.Column="1" Background="#FF141428" BorderBrush="#FF2A2A4A" BorderThickness="1 0 0 0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Node Properties" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFCCCCEE" Margin="0 0 0 16"/>

                    <!-- Label -->
                    <TextBlock Text="Label" Foreground="#FF9999BB" FontSize="11" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding SelectedNode.Label, UpdateSourceTrigger=PropertyChanged}"
                             Background="#FF1A1A2E" Foreground="White"
                             BorderBrush="#FF3A3A6A" BorderThickness="1"
                             Padding="6 4" Margin="0 0 0 12"/>

                    <!-- Node type -->
                    <TextBlock Text="Type" Foreground="#FF9999BB" FontSize="11" Margin="0 0 0 4"/>
                    <ComboBox SelectedItem="{Binding SelectedNode.NodeType}"
                              Background="#FF1A1A2E" Foreground="White"
                              BorderBrush="#FF3A3A6A" BorderThickness="1"
                              Margin="0 0 0 12">
                        <ComboBoxItem>Action</ComboBoxItem>
                        <ComboBoxItem>Delay</ComboBoxItem>
                        <ComboBoxItem>Condition</ComboBoxItem>
                        <ComboBoxItem>Loop</ComboBoxItem>
                    </ComboBox>

                    <!-- Parameter -->
                    <TextBlock Text="Parameter" Foreground="#FF9999BB" FontSize="11" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding SelectedNode.Parameter, UpdateSourceTrigger=PropertyChanged}"
                             Background="#FF1A1A2E" Foreground="White"
                             BorderBrush="#FF3A3A6A" BorderThickness="1"
                             Padding="6 4" Margin="0 0 0 12"/>

                    <!-- Icon preview -->
                    <TextBlock Text="{Binding SelectedNode.NodeIcon, FallbackValue='–'}" FontSize="40"
                               HorizontalAlignment="Center" Margin="0 12 0 0"
                               Foreground="{Binding SelectedNode.NodeColor, FallbackValue=White}"/>

                    <!-- Help text -->
                    <TextBlock Margin="0 20 0 0" Foreground="#FF666688" FontSize="10" TextWrapping="Wrap">
                        Action: keyboard shortcut (e.g. Ctrl+C)&#x0a;
                        Delay: milliseconds (e.g. 500)&#x0a;
                        Condition: expression (e.g. true)&#x0a;
                        Loop: repeat count (e.g. 3)
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Status bar ───────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#FF0F0F20" Padding="16 6">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FF666688" FontSize="11"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#FF444466" FontSize="11">
                    <Run Text="{Binding Nodes.Count, Mode=OneWay, StringFormat={}{0} nodes}"/>
                    <Run Text=" | "/>
                    <Run Text="{Binding Connections.Count, Mode=OneWay, StringFormat={}{0} connections}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
